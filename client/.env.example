# Salin ke .env.local (tidak ikut Git). Kosongkan untuk memakai nomor orang tua.
# Nomor uji WhatsApp: seluruh pesan "Kirim ke WhatsApp" diarahkan ke nomor ini.
VITE_WA_NOMOR_UJI=

# Alamat portal yang bisa dijangkau ponsel orang tua (tanpa garis miring di
# akhir), dipakai untuk tautan hasil di pesan WhatsApp. Pada QA LAN: alamat IP
# komputer server, mis. http://192.168.1.20:5173. Kosong = alamat yang sedang
# dibuka petugas; bila itu localhost, tautannya tidak bisa dibuka orang tua.
VITE_ALAMAT_PUBLIK=
