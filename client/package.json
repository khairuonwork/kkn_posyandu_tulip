{
    "name": "posyandu-tulip-client",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "demo": "vite --config vite.demo.config.ts",
        "demo:build": "vite build --config vite.demo.config.ts",
        "test": "node --test \"test/**/*.test.ts\"",
        "types:check": "tsc --noEmit",
