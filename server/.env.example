# Salin menjadi .env.
#
# Port 5433, bukan 5432: lihat alasannya di docker-compose.yml. Bila memakai
# PostgreSQL sendiri, ganti seluruh baris ini dengan sambungan milikmu.
DATABASE_URL=postgres://posyandu:posyandu@127.0.0.1:5433/posyandu_tulip

# Porta server HTTP. Bawaannya 4321 — bukan 3000, yang terlalu sering sudah
# dipakai aplikasi lain. Pada Windows tabrakan port tidak berbunyi: proses
# kedua tetap mengaku siap, lalu permintaan mendarat di aplikasi yang salah.
# PORT=4321
